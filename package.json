{
  "name": "message-archivist",
  "version": "0.0.1.0",
  "private": true,
  "description": "Chrome extension that backs up Google Messages for Web conversations to a folder on your computer, checks the backup is complete, and lets you read and analyse it offline.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node test/restore/import-phone.mjs extension/library.js && node test/importers/run.mjs",
    "package": "node scripts/check.mjs && node scripts/package.mjs",
    "set-version": "node scripts/set-version.mjs"
  },
  "homepage": "https://github.com/trikhster/message-archivist#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/trikhster/message-archivist.git"
  },
  "bugs": {
    "url": "https://github.com/trikhster/message-archivist/issues"
  }
}
