{
	"nodes": [
		{
			"id": "g-title",
			"type": "text",
			"x": 0,
			"y": 0,
			"width": 900,
			"height": 120,
			"text": "# Message Archivist: code map\nFeatures on top, wired to the code that does them. Below, every file, its sections and functions. Regenerate with `npm run code-map`; see [[Code map]]."
		},
		{
			"id": "g-seg-messages",
			"type": "text",
			"text": "## Google Messages backup\nReads chats out of messages.google.com and writes them into the backup folder, one chat or all of them.\n[[Backup run]]",
			"color": "5",
			"width": 300,
			"height": 204,
			"x": 0,
			"y": 210
		},
		{
			"id": "g-seg-schedules",
			"type": "text",
			"text": "## Automatic backups\nAlarms from every hour to every 30 days run the due chats in the Messages tab.\n[[Background worker]]",
			"color": "5",
			"width": 300,
			"height": 204,
			"x": 340,
			"y": 210
		},
		{
			"id": "g-seg-photos",
			"type": "text",
			"text": "## Photos and media\nFetching, full-size upgrades, duplicates and every picture’s status.\n[[Photo statuses and runs]]",
			"color": "5",
			"width": 300,
			"height": 204,
			"x": 680,
			"y": 210
		},
		{
			"id": "g-seg-library",
			"type": "text",
			"text": "## The library on disk\nPer-chat files, the index (data.js), merging, completeness checks and checksums.\n[[Library format]]",
			"color": "4",
			"width": 300,
			"height": 204,
			"x": 1020,
			"y": 210
		},
		{
			"id": "g-seg-people",
			"type": "text",
			"text": "## People across apps\nOne person across apps, accounts and numbers; leaving codes and automated texts out.\n[[Sources]]",
			"color": "4",
			"width": 300,
			"height": 204,
			"x": 1360,
			"y": 210
		},
		{
			"id": "g-seg-discord",
			"type": "text",
			"text": "## Discord\nDiscord’s data package.\n[[Importers]]",
			"color": "2",
			"width": 300,
			"height": 204,
			"x": 2380,
			"y": 210
		},
		{
